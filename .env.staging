# Staging Environment Configuration

# AWS Configuration
AWS_REGION=ap-northeast-1

# Environment
ENVIRONMENT=staging

# Application Configuration
APP_NAME=meeting-minutes-generator

# S3 Configuration
INPUT_BUCKET_NAME=meeting-minutes-input-staging
OUTPUT_BUCKET_NAME=meeting-minutes-output-staging

# DynamoDB Configuration
JOBS_TABLE_NAME=MeetingJobs-staging

# Transcribe Configuration
TRANSCRIBE_LANGUAGE_CODE=ja-JP

# Bedrock Configuration
# Inference Profile IDを使用（APACリージョンのClaude 3.5 Sonnet v2）
BEDROCK_MODEL_ID=apac.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REGION=ap-northeast-1

# File Upload Limits
MAX_FILE_SIZE_MB=2048
ALLOWED_FILE_TYPES=video/mp4

# API Configuration
API_STAGE=staging
CORS_ALLOWED_ORIGINS=https://staging.example.com,http://localhost:3000

# Frontend Deployment Method
USE_AMPLIFY=true

# GitHub Configuration (for Amplify auto-deployment)
GITHUB_BRANCH=develop
