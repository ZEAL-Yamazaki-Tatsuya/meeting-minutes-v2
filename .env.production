# Production Environment Configuration

# AWS Configuration
AWS_REGION=ap-northeast-1

# Environment
ENVIRONMENT=prod

# Application Configuration
APP_NAME=meeting-minutes-generator

# S3 Configuration
INPUT_BUCKET_NAME=meeting-minutes-input-prod
OUTPUT_BUCKET_NAME=meeting-minutes-output-prod

# DynamoDB Configuration
JOBS_TABLE_NAME=MeetingJobs-prod

# Transcribe Configuration
TRANSCRIBE_LANGUAGE_CODE=ja-JP

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_REGION=us-east-1

# File Upload Limits
MAX_FILE_SIZE_MB=2048
ALLOWED_FILE_TYPES=video/mp4

# API Configuration
API_STAGE=prod
CORS_ALLOWED_ORIGINS=https://app.example.com

# Frontend Deployment Method
USE_AMPLIFY=true

# GitHub Configuration (for Amplify auto-deployment)
GITHUB_BRANCH=main
