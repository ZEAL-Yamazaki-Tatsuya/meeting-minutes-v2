# AWS Configuration
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1

# Environment
ENVIRONMENT=dev

# Application Configuration
APP_NAME=meeting-minutes-generator

# S3 Configuration
INPUT_BUCKET_NAME=meeting-minutes-input-dev
OUTPUT_BUCKET_NAME=meeting-minutes-output-dev

# DynamoDB Configuration
JOBS_TABLE_NAME=MeetingJobs-dev

# Transcribe Configuration
TRANSCRIBE_LANGUAGE_CODE=ja-JP

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_REGION=us-east-1

# File Upload Limits
MAX_FILE_SIZE_MB=2048
ALLOWED_FILE_TYPES=video/mp4

# API Configuration
API_STAGE=dev
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional: Cognito (for authentication)
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_CALLBACK_URLS=http://localhost:3000/auth/callback,https://yourdomain.com/auth/callback
# COGNITO_LOGOUT_URLS=http://localhost:3000,https://yourdomain.com

# Frontend Configuration
# NEXT_PUBLIC_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/dev
# NEXT_PUBLIC_APP_URL=https://your-cloudfront-domain.cloudfront.net
# NEXT_PUBLIC_COGNITO_USER_POOL_ID=
# NEXT_PUBLIC_COGNITO_CLIENT_ID=
# NEXT_PUBLIC_AWS_REGION=us-east-1

# Frontend Deployment Method
# USE_AMPLIFY=true  # Use AWS Amplify Hosting (recommended for Next.js)
# USE_AMPLIFY=false # Use CloudFront + S3 (static export only)

# GitHub Configuration (for Amplify auto-deployment)
# GITHUB_REPO=https://github.com/username/repo
# GITHUB_BRANCH=main
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxx

# Monitoring Configuration
# ALERT_EMAIL=your-email@example.com  # Email address for CloudWatch alarms
